{
  "environment_class": "diablo_training.xingtian_env:XingtianFlatEnv",
  "config_class": "diablo_training.xingtian_env:XingtianConfig",
  "environment": {
    "episode_seconds": 30.0,
    "max_speed": 1.0,
    "max_backward_speed": 0.8,
    "max_yaw_rate": 1.5,
    "min_height": 0.16,
    "max_height": 0.34,
    "command_duration_min": 2.0,
    "command_duration_max": 6.0,
    "command_ramp_seconds": 0.35,
    "observation_noise": true,
    "action_mode": "position_velocity"
  },
  "ppo": {
    "n_steps": 64,
    "batch_size": 256,
    "n_epochs": 5,
    "learning_rate": 0.0005,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "ent_coef": 0.008,
    "policy_kwargs": {
      "net_arch": [128, 64]
    }
  }
}
